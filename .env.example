# Copy to .env for local dev (never commit real secrets).

# --- Client auth gate for OUR MCP endpoint ---
# Comma-separated API keys that MCP clients must present
# (Authorization: Bearer <key>  or  X-API-Key: <key>).
# Leave empty to DISABLE the gate (local dev only — never in production).
MCP_API_KEYS=dev-key-change-me

# --- Meltwater MIRA (upstream) ---
# From Meltwater app: Account > Meltwater API. Enables the mira_* tools.
MELTWATER_API_KEY=
# MELTWATER_BASE_URL=https://api.meltwater.com

# --- BSE (upstream, no key needed; override only if endpoints move) ---
# BSE_API_BASE=https://api.bseindia.com/BseIndiaAPI/api
# BSE_WEB_BASE=https://www.bseindia.com/

# --- Server / HTTP tuning ---
HOST=0.0.0.0
PORT=8000
# MCP_MOUNT_PATH=/mcp
# HTTP_TIMEOUT=20          # BSE request timeout (seconds)
# MIRA_TIMEOUT=120         # MIRA timeout (seconds); grounded answers can take ~30s+
# MAX_RETRIES=2
# MICRO_CACHE_TTL=5
